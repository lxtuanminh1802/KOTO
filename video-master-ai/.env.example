# Copy to .env and adjust. Every VMA_* key maps to backend/app/config.py.
VMA_JWT_SECRET=replace-with-a-long-random-string
# Demo mode: accepts OTP 000000 and shows demo accounts on the login screen. Turn off in production.
VMA_DEMO_MODE=true
# Load the two sample cases (renders three demo CCTV clips on first start, about one minute).
VMA_SEED_DEMO=true
# simulated (default) | opencv
VMA_AI_ENGINE=simulated
VMA_WORKER_CONCURRENCY=2
VMA_CLIP_MODE=copy
# Map tiles (UR-MAP). Leave empty to use the offline schematic map.
VMA_MAPTILER_KEY=
VMA_CORS_ORIGINS=http://localhost:8080
MYSQL_PASSWORD=vma
MYSQL_ROOT_PASSWORD=change-me-root
WEB_PORT=8080
